{
  "name": "eventrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build --config web/vite.config.ts",
    "test": "tsx --test tests/health.test.ts tests/auth.test.ts tests/resources.test.ts tests/ingestion.test.ts tests/delivery.test.ts tests/security.test.ts tests/production-security.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "dev:dashboard": "concurrently -k \"npm:dev\" \"npm:dev:web\"",
    "dev:stack": "concurrently -k \"npm:dev\" \"npm:dev:web\" \"npm:worker\"",
    "start": "node dist/server/server.js",
    "start:worker": "node dist/server/worker/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.8"
  }
}
